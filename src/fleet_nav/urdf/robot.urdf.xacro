<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg robot_name)">

  <xacro:arg name="robot_name" default="robot_1"/>
  <xacro:arg name="chassis_rgba" default="0.2 0.2 1 1"/>
  <xacro:property name="robot_name" value="$(arg robot_name)"/>
  <xacro:property name="chassis_rgba" value="$(arg chassis_rgba)"/>

  <!-- Include Core -->
  <xacro:include filename="robot_core.xacro" />
  
  <!-- Include Sensors -->
  <xacro:include filename="lidar.xacro" />
  <xacro:include filename="imu.xacro" />
  <xacro:include filename="camera.xacro" />

  <!-- Gazebo Sim Plugins (Native DiffDrive & Joint State Publisher) -->
  <gazebo>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.35</wheel_separation>
      <wheel_radius>0.1</wheel_radius>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
      <topic>/model/${robot_name}/cmd_vel</topic>
      <!-- Wheel integration is not the pose used for navigation. The ground-truth
           publisher owns /odometry and /tf. Leaving both on those topics mixes
           a pose at the origin with the world pose. -->
      <odom_topic>/model/${robot_name}/wheel_odometry</odom_topic>
      <tf_topic>/model/${robot_name}/wheel_tf</tf_topic>
      <frame_id>${robot_name}/odom</frame_id>
      <child_frame_id>${robot_name}/base_link</child_frame_id>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/model/${robot_name}/joint_states</topic>
    </plugin>
  </gazebo>

</robot>
